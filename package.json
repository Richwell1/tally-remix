    "dev:test-mfa-user": "node scripts/create-test-mfa-user.mjs",
    "sync:once": "node scripts/sync-once.mjs",
    "sync:watch": "node scripts/sync-watch.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config .output/server/wrangler.json",
